---
layout: base.njk
mainClass: post-page
---

<article class="post">
    <header class="post-header">
        <h1>{{ title }}</h1>
        <div class="post-meta">
            {% if created %}
            <span>{{ created | vhsDate }}</span>
            {% endif %}
            {% if mileage %}
            <span>{{ mileage | commaNumber }} MI</span>
            {% endif %}
            {% if category %}
            <span>{{ category | upper }}</span>
            {% endif %}
            {% if cost %}
            <span>${{ cost | commaNumber }}</span>
            {% endif %}
            {% if updated and updated != created %}
            <span>UPDATED {{ updated | vhsDate }}</span>
            {% endif %}
        </div>
    </header>

    <div class="post-content">
        {{ content | safe }}
    </div>

    {% if parts %}
    <div class="post-parts">
        <h2>parts</h2>
        <ul>
        {% for part in parts %}
            <li>{{ part }}</li>
        {% endfor %}
        </ul>
    </div>
    {% endif %}

    <footer class="post-footer">
        <a href="/4runner/">&larr; Back to the build log</a>
    </footer>
</article>
